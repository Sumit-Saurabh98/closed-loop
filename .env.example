# Closed Loop: environment template
# Copy to .env (git-ignored) and fill in. Never commit real values.

# ---- GitHub (used by scripts/setup-demo-repo.sh and by agents via `gh`) ----
# Agents use your `gh auth login` session; a token here is only needed for CI or headless runs.
GITHUB_OWNER=your-github-username
DEMO_REPO_NAME=cartwheel
DEMO_REPO_VISIBILITY=public          # public | private
# GITHUB_TOKEN=ghp_xxx               # optional; prefer `gh auth login`

# ---- Switch template params (mirrors switch/closed-loop.template.yaml) ----
SWITCH_TEAM_PREFIX=cl
SWITCH_COMMUNITY_BRIDGE=Discord      # display name of the messaging app in Switch Console
SWITCH_ENG_BRIDGE=Mattermost
MAINTAINER_HANDLE=your-chat-handle   # the only person whose "approve LOOP-n" merges

# ---- Discord (pasted into Switch Console > Messaging apps > Connect; kept here for reference) ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# ---- cartwheel ----
PORT=3000
VITE_COMMUNITY_URL=          # Discord invite link for the shop footer, e.g. https://discord.gg/xxxx
TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD_CENTS=5000
SHIPPING_CENTS=499

# ---- Agent provider ----
# Claude Code uses its own login (`claude` → /login). Only set this for API-key auth.
# ANTHROPIC_API_KEY=sk-ant-xxx
