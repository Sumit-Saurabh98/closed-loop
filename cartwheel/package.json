{
  "name": "cartwheel",
  "version": "1.0.0",
  "description": "Cartwheel: a tiny cart and checkout API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "web:install": "npm --prefix web install",
    "web": "npm --prefix web run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  }
}
